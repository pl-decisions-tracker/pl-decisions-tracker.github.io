---
import { getCountryRoutes } from '../../utils/contryRoutes';
import { readFileSync } from 'node:fs';

export async function getStaticPaths() {
  const manifest = JSON.parse(
    readFileSync('public/data/index.json', 'utf-8')
  );
  return getCountryRoutes()
    .map((c) => {
      const years: number[] = manifest['decisions']?.[c.params.country] ?? [];
      const latest = years.length ? years[years.length - 1] : null;
      return { params: c.params, props: { latest } };
    })
    .filter((r) => r.props.latest !== null);
}

const { latest } = Astro.props;
const target = '../' + latest + '/decisions.html';
const refresh = '0; url=' + target;
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={refresh} />
    <title>Redirect...</title>
  </head>
  <body>
    <p>Таблицы теперь разбиты по годам.
      <a href={target}>Открыть таблицу за {latest} год</a>.
    </p>
  </body>
</html>